{% extends 'admin/base_admin.html.twig' %}

{% block title %}Dashboard{% endblock %}

{% block body %}
    {% include 'admin/_nav.html.twig' %}

    <section class="mx-auto max-w-6xl px-6 pb-12">
        <div class="mb-8 flex items-center justify-between">
            <div class="space-y-1">
                <p class="text-sm font-semibold uppercase tracking-widest text-indigo-600">Resumen</p>
                <h1 class="text-3xl font-bold text-slate-900">Panel de control</h1>
                <p class="text-slate-600">Sigue el pulso de las partidas y entradas del sistema.</p>
            </div>
            <div data-controller="utility" data-utility-copy-value="bin/console app:create-admin" class="flex items-center gap-2">
                <span class="hidden text-sm text-slate-500 sm:block">Crear un admin rápido</span>
                <button type="button" data-action="utility#copy" class="rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm font-semibold text-slate-700 shadow-sm hover:bg-slate-50">Copiar comando</button>
            </div>
        </div>

        <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
            <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
                <p class="text-sm font-semibold text-slate-500">Salas</p>
                <p class="mt-2 text-3xl font-black text-slate-900">{{ stats.rooms }}</p>
                <p class="text-xs text-slate-500">Salas creadas</p>
            </div>
            <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
                <p class="text-sm font-semibold text-slate-500">Partidas</p>
                <p class="mt-2 text-3xl font-black text-slate-900">{{ stats.games }}</p>
                <p class="text-xs text-slate-500">Total de juegos</p>
            </div>
            <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
                <p class="text-sm font-semibold text-slate-500">Jugadores</p>
                <p class="mt-2 text-3xl font-black text-slate-900">{{ stats.players }}</p>
                <p class="text-xs text-slate-500">Registros</p>
            </div>
            <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
                <p class="text-sm font-semibold text-slate-500">Cartones</p>
                <p class="mt-2 text-3xl font-black text-slate-900">{{ stats.cards }}</p>
                <p class="text-xs text-slate-500">Generados</p>
            </div>
            <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
                <p class="text-sm font-semibold text-slate-500">Reclamaciones</p>
                <p class="mt-2 text-3xl font-black text-slate-900">{{ stats.claims }}</p>
                <p class="text-xs text-slate-500">Enviadas</p>
            </div>
        </div>

        <div class="mt-10 grid gap-6 lg:grid-cols-3">
            <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm lg:col-span-2">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm font-semibold uppercase tracking-widest text-indigo-600">Actividad</p>
                        <h2 class="text-xl font-bold text-slate-900">Últimas reclamaciones</h2>
                    </div>
                    <a class="text-sm font-semibold text-indigo-600 hover:text-indigo-500" href="{{ path('app_admin_claims') }}">Ver todas</a>
                </div>
                <div class="mt-4 divide-y divide-slate-100">
                    {% if recentClaims is not empty %}
                        {% for claim in recentClaims %}
                            <div class="flex items-center justify-between py-3">
                                <div>
                                    <p class="font-semibold text-slate-900">{{ claim.type|capitalize }}</p>
                                    <p class="text-sm text-slate-500">Estado: {{ claim.status|capitalize }} • {{ claim.createdAt|date('d/m/Y H:i') }}</p>
                                </div>
                                <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-700">{{ claim.game ? claim.game.id : 'Juego' }}</span>
                            </div>
                        {% endfor %}
                    {% else %}
                        <p class="py-6 text-sm text-slate-500">Todavía no hay reclamaciones registradas.</p>
                    {% endif %}
                </div>
            </div>
            <div class="space-y-4">
                <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
                    <p class="text-sm font-semibold text-slate-500">Acceso rápido</p>
                    <div class="mt-3 space-y-2" data-controller="utility" data-utility-copy-value="{{ app.request.schemeAndHttpHost ~ path('app_login') }}">
                        <button type="button" data-action="utility#copy" class="w-full rounded-lg border border-slate-200 px-3 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50">Copiar enlace de login</button>
                        <a href="{{ path('app_admin_rooms') }}" class="block rounded-lg bg-slate-900 px-3 py-2 text-center text-sm font-semibold text-white hover:bg-slate-800">Ver salas</a>
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endblock %}
