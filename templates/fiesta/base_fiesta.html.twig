<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>{% block title %}Modo Fiesta - BingoEnCasa{% endblock %}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
    {{ vite_entry_link_tags('fiesta') }}
    {% block stylesheets %}{% endblock %}
</head>
<body class="text-white antialiased min-h-screen">
    <div class="min-h-screen flex flex-col">
        {% block body %}{% endblock %}
    </div>
    {{ vite_entry_script_tags('fiesta') }}
    {% block javascripts %}{% endblock %}
</body>
</html>
