{% extends 'fiesta/base_fiesta.html.twig' %}

{% block title %}Jugando - {{ room.code }}{% endblock %}

{% block body %}
<div id="app" class="flex-1 flex flex-col w-full max-w-lg mx-auto"></div>

{# Fuera de #app: el polling no los reconstruye, así un toque nunca cae en un botón que se está sustituyendo. #}
<div id="actions" class="fixed bottom-0 left-0 right-0 px-4 pt-4 flex gap-3 max-w-lg mx-auto" style="background:linear-gradient(to top,#0a0b0f 60%,transparent);padding-bottom:max(1rem,env(safe-area-inset-bottom))" hidden>
    <button type="button" data-claim="LINEA" class="f-btn f-btn-linea flex-1 rounded-2xl py-4 font-bold">¡LÍNEA!</button>
    <button type="button" data-claim="BINGO" class="f-btn f-btn-bingo flex-1 rounded-2xl py-4 font-bold">¡BINGO!</button>
</div>
<div id="net" class="f-net rounded-full px-4 py-2 text-sm font-semibold flex items-center gap-2" role="status">
    <span class="f-spin rounded-full flex-shrink-0" style="width:14px;height:14px;border:2px solid rgba(255,208,137,0.3);border-top-color:#ffd089"></span>
    <span>Sin conexión. Reintentando…</span>
</div>
<div id="toast" class="f-toast rounded-2xl px-4 py-3 text-sm font-semibold text-center" role="alert"></div>

<script>
const jugadorId = {{ player.id.toBase32|json_encode|raw }};
const apodoPropio = {{ player.nickname|json_encode|raw }};
const salaCodigo = {{ room.code|json_encode|raw }};

let partidaId = null;
let drawnBalls = [];
let history = [];
let currentBall = null;
let cards = [];
let players = [];
let estado = null;          // último estado completo del servidor
let view = 'espera';        // espera | jugando | comprobando | aviso | ganaste | fin
let pendingClaim = null;    // tipo reclamado mientras esperamos confirmación
let pendingClaimAt = 0;

let armed = null;           // botón tocado una vez, a la espera de confirmar
let armTimer = null;
let roomClosed = false;     // la sala se liberó: el jugador ya no pertenece a ella

const POLL_BASE = 1500;
const FETCH_TIMEOUT = 8000;
let pollInterval = POLL_BASE;
let pollTimer = null;
let polling = false;
let stopped = false;
let errorCount = 0;
let lobbyEtag = null;
let estadoEtag = null;

// ---------- móvil / nativo (Web APIs + Capacitor WebView) ----------
let wakeLock = null;
let ownNumbers = new Set();   // números presentes en mis cartones
let prevBallSeen = null;

function vibrate(pattern) {
    try { if (navigator.vibrate) navigator.vibrate(pattern); } catch (e) { /* no soportado */ }
    // En la WebView de iOS (sin navigator.vibrate) usa Haptics de Capacitor.
    try { if (window.bingoNative) window.bingoNative.haptic(Array.isArray(pattern) ? 'win' : 'tap'); } catch (e) {}
}
async function requestWake() {
    try {
        if ('wakeLock' in navigator && !wakeLock) {
            wakeLock = await navigator.wakeLock.request('screen');
            wakeLock.addEventListener('release', () => { wakeLock = null; });
        }
    } catch (e) { /* no soportado / sin permiso */ }
    try { if (window.bingoNative) window.bingoNative.keepAwake(true); } catch (e) {}
}
function releaseWake() {
    try { if (wakeLock) { wakeLock.release(); wakeLock = null; } } catch (e) {}
    try { if (window.bingoNative) window.bingoNative.keepAwake(false); } catch (e) {}
}

// ---------- helpers de cartón ----------
function rowMissing(row) {
    const nums = row.filter(n => n);
    return nums.filter(n => !drawnBalls.includes(n)).length;
}
function rowFilled(row) {
    return row.filter(n => n).length > 0;
}
function bestLineMissing() {
    let best = 99;
    cards.forEach(c => (c.cuadricula || []).forEach(r => { if (rowFilled(r)) best = Math.min(best, rowMissing(r)); }));
    return best;
}
function bestBingoMissing() {
    let best = 99;
    cards.forEach(c => {
        const nums = (c.cuadricula || []).flat().filter(n => n);
        if (nums.length) best = Math.min(best, nums.filter(n => !drawnBalls.includes(n)).length);
    });
    return best;
}
function cardCompletesLinea(card) {
    return (card.cuadricula || []).some(row => rowFilled(row) && rowMissing(row) === 0);
}
function cardCompletesBingo(card) {
    const nums = (card.cuadricula || []).flat().filter(n => n);
    return nums.length > 0 && nums.every(n => drawnBalls.includes(n));
}
function pickClaimCard(tipo) {
    const completes = tipo === 'LINEA' ? cardCompletesLinea : cardCompletesBingo;
    return cards.find(completes) || cards[0];
}

// ---------- componentes ----------
// Todo texto que escribe un usuario (apodos) pasa por aquí antes de ir a innerHTML.
function esc(value) {
    return String(value ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
}

function ball3D(num, size) {
    const s = size || 96;
    const fs = Math.round(s * 0.42);
    return `<div class="f-ball f-pop rounded-full flex items-center justify-center font-black"
        style="width:${s}px;height:${s}px;font-size:${fs}px;letter-spacing:-0.03em;font-family:'Space Grotesk',Inter,sans-serif;">${num || '?'}</div>`;
}

function avatar(name, sz) {
    const s = sz || 32;
    const initial = (name || '?').charAt(0).toUpperCase();
    return `<div class="rounded-full flex items-center justify-center font-bold text-white flex-shrink-0"
        style="width:${s}px;height:${s}px;font-size:${Math.round(s*0.45)}px;background:linear-gradient(135deg,#8b5cf6,#ec4899 55%,#22d3ee)">${esc(initial)}</div>`;
}

function cardHtml(card) {
    const winningLine = cardCompletesLinea(card);
    const rows = (card.cuadricula || []).map(row => {
        const isWinRow = winningLine && rowFilled(row) && rowMissing(row) === 0;
        const cells = row.map(num => {
            if (!num) return `<div class="f-cell--empty rounded-md aspect-square"></div>`;
            const marked = drawnBalls.includes(num);
            const cls = isWinRow && marked ? 'f-cell--line' : (marked ? 'f-cell--marked' : 'f-cell');
            return `<div class="${cls} rounded-md aspect-square flex items-center justify-center font-bold text-sm"
                style="font-family:'Space Grotesk',Inter,sans-serif;">${num}</div>`;
        }).join('');
        return `<div class="grid grid-cols-9 gap-1">${cells}</div>`;
    }).join('');
    return `<div class="rounded-2xl p-3 flex flex-col gap-1" style="background:#13141b;border:1px solid rgba(255,255,255,0.06)">${rows}</div>`;
}

function objetivoPill() {
    const obj = (estado && estado.premioObjetivo) || 'LINEA';
    const color = obj === 'BINGO' ? '#ffce4d' : '#2fd4e3';
    return `<span class="text-[11px] font-bold px-2 py-0.5 rounded-full" style="color:${color};background:rgba(255,255,255,0.06)">Objetivo: ${obj}</span>`;
}

function points(value) {
    return Number(value ?? 0).toFixed(0);
}

function prizesBar() {
    if (!estado || !(estado.boteTotal > 0)) return '';
    return `<div class="rounded-xl p-3" style="background:#13141b;border:1px solid rgba(255,255,255,0.06)">
        <div class="flex justify-center gap-6 text-sm">
            <div class="text-center"><span class="text-white/40 text-xs">Línea</span><p class="font-bold" style="color:#2fd4e3">${points(estado.premioLinea)}</p></div>
            <div class="text-center"><span class="text-white/40 text-xs">Bingo</span><p class="font-bold" style="color:#ffce4d">${points(estado.premioBingo)}</p></div>
            <div class="text-center"><span class="text-white/40 text-xs">Bote</span><p class="font-bold" style="color:#3ed993">${points(estado.boteTotal)}</p></div>
        </div></div>`;
}

// ---------- pantallas ----------
function renderEspera() {
    const list = players.map(p => `<div class="flex flex-col items-center gap-1">${avatar(p, 44)}<span class="text-[11px] text-white/60 max-w-[64px] truncate">${esc(p)}</span></div>`).join('');
    const nCartones = cards.length;
    return `<div class="flex-1 flex flex-col items-center justify-center text-center p-6 gap-5">
        <div class="f-spin rounded-full" style="width:56px;height:56px;border:4px solid rgba(47,212,227,0.25);border-top-color:#2fd4e3"></div>
        <h1 class="text-2xl font-black">¡Estás dentro!</h1>
        <div class="rounded-2xl px-5 py-3" style="background:#13141b;border:1px solid rgba(255,255,255,0.06)">
            <p class="text-white/40 text-xs uppercase tracking-widest">Sala</p>
            <p class="text-3xl font-black tracking-tight" style="font-family:'Space Grotesk',Inter,sans-serif">${salaCodigo}</p>
        </div>
        ${players.length ? `<div class="flex flex-wrap justify-center gap-3 max-w-sm">${list}</div>` : ''}
        ${nCartones ? `<p class="text-white/50 text-sm">Tienes <span class="font-bold text-white">${nCartones}</span> cartón${nCartones > 1 ? 'es' : ''} reservado${nCartones > 1 ? 's' : ''}.</p>` : `<p class="text-white/40 text-sm">Esperando a que el anfitrión empiece la partida…</p>`}
    </div>`;
}

function renderJugando() {
    const lineMissing = bestLineMissing();
    const bingoMissing = bestBingoMissing();
    const obj = (estado && estado.premioObjetivo) || 'LINEA';

    let faltaBar = '';
    if (obj !== 'BINGO' && lineMissing === 1) {
        faltaBar = `<div class="f-falta f-pulse rounded-xl p-3 text-center text-sm font-bold">¡Te falta 1 para LÍNEA!</div>`;
    } else if (bingoMissing === 1) {
        faltaBar = `<div class="f-falta f-pulse rounded-xl p-3 text-center text-sm font-bold">¡Te falta 1 para BINGO!</div>`;
    }

    const hist = history.slice(1, 6).map(n => `<div class="rounded-full flex items-center justify-center text-xs font-bold f-ball" style="width:34px;height:34px;font-family:'Space Grotesk',Inter,sans-serif">${n}</div>`).join('');
    const cardsHtml = cards.length ? cards.map(cardHtml).join('') : `<p class="text-white/40 text-center py-6">Sin cartones asignados</p>`;

    return `<div class="flex-1 flex flex-col p-4 gap-4 overflow-y-auto pb-28">
        <header class="rounded-2xl p-4 flex items-center justify-between" style="background:#13141b;border:1px solid rgba(255,255,255,0.06)">
            <div><span class="text-white/40 text-xs">Sala</span><p class="font-bold">${salaCodigo}</p></div>
            <span class="px-3 py-1 rounded-full text-xs font-bold" style="background:rgba(62,217,147,0.16);color:#8af0c0">EN JUEGO</span>
            <div class="text-right"><span class="text-white/40 text-xs">Jugador</span><p class="font-bold">${esc(apodoPropio)}</p></div>
        </header>
        <div class="flex justify-center">${objetivoPill()}</div>
        ${prizesBar()}
        <div class="rounded-3xl p-6 flex flex-col items-center gap-3" style="background:#13141b;border:1px solid rgba(255,255,255,0.06)">
            <p class="text-white/40 text-sm">Última bola</p>
            ${ball3D(currentBall, 96)}
            <div class="flex gap-2 flex-wrap justify-center">${hist}</div>
        </div>
        ${faltaBar}
        <div class="flex flex-col gap-3">${cardsHtml}</div>
    </div>`;
}

// Los botones de cantar viven fuera de #app: aquí solo se actualizan sus atributos.
function updateActions() {
    const bar = document.getElementById('actions');
    bar.hidden = view !== 'jugando';
    if (bar.hidden) { disarm(); return; }

    const obj = (estado && estado.premioObjetivo) || 'LINEA';
    if (armed === 'LINEA' && obj === 'BINGO') disarm();

    bar.querySelectorAll('[data-claim]').forEach(btn => {
        const tipo = btn.dataset.claim;
        const ready = tipo === 'LINEA' ? obj !== 'BINGO' && bestLineMissing() === 0 : bestBingoMissing() === 0;
        const isArmed = armed === tipo;
        const name = tipo === 'LINEA' ? '¡LÍNEA!' : '¡BINGO!';
        btn.disabled = tipo === 'LINEA' && obj === 'BINGO';
        btn.classList.toggle('f-pulse', ready && !isArmed);
        btn.classList.toggle('is-armed', isArmed);
        btn.setAttribute('aria-label', isArmed ? `Confirmar ${name}` : name);
        const label = isArmed ? 'Confirmar' : name;
        if (btn.textContent !== label) btn.textContent = label;
    });
}

// Primer toque: el botón pide confirmación durante 3 s. Segundo toque: canta.
function arm(tipo) {
    armed = tipo;
    clearTimeout(armTimer);
    armTimer = setTimeout(() => { armed = null; updateActions(); }, 3000);
    vibrate(20);
    updateActions();
}
function disarm() {
    armed = null;
    clearTimeout(armTimer);
}
document.getElementById('actions').addEventListener('click', e => {
    const btn = e.target.closest('[data-claim]');
    if (!btn || btn.disabled) return;
    const tipo = btn.dataset.claim;
    if (armed === tipo) {
        disarm();
        reclamar(tipo);
    } else {
        arm(tipo);
    }
});

// ---------- avisos ----------
let toastTimer = null;
function showToast(msg) {
    const el = document.getElementById('toast');
    el.textContent = msg;
    el.classList.add('is-visible');
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => el.classList.remove('is-visible'), 4500);
}
function updateConnection() {
    const offline = !navigator.onLine || errorCount >= 2;
    document.getElementById('net').classList.toggle('is-visible', offline && !stopped);
}

function renderComprobando() {
    const tipo = (estado && estado.reclamacionActiva && estado.reclamacionActiva.tipo) || pendingClaim || 'LÍNEA';
    return `<div class="f-overlay flex-1 flex flex-col items-center justify-center text-center p-8 gap-5">
        <div class="f-spin rounded-full" style="width:60px;height:60px;border:4px solid rgba(255,176,32,0.25);border-top-color:#ffb020"></div>
        <h2 class="text-2xl font-black">Has cantado ¡${tipo}!</h2>
        <p class="text-white/55 max-w-xs">El anfitrión está revisando tu cartón. Un momento…</p>
    </div>`;
}

function renderAviso() {
    const rc = estado.reclamacionActiva;
    const color = rc.tipo === 'BINGO' ? '#ffce4d' : '#2fd4e3';
    return `<div class="f-overlay flex-1 flex flex-col items-center justify-center text-center p-8 gap-5">
        ${avatar(rc.apodo, 64)}
        <h2 class="text-2xl font-black"><span style="color:${color}">${esc(rc.apodo)}</span> canta ¡${rc.tipo}!</h2>
        <p class="text-white/55 max-w-xs">El anfitrión lo está comprobando. ${rc.tipo === 'LINEA' ? 'Seguimos para bingo.' : ''}</p>
    </div>`;
}

function renderGanaste() {
    const g = estado.ganador;
    const premio = g && g.premio > 0 ? ` · ${Number(g.premio).toFixed(0)} puntos` : '';
    launchConfetti();
    return `<div class="f-overlay flex-1 flex flex-col items-center justify-center text-center p-8 gap-5">
        ${ball3D(currentBall || '★', 120)}
        <h1 class="text-4xl font-black" style="color:#ffce4d">¡BINGO!</h1>
        <p class="text-xl font-bold">¡Has ganado!${premio}</p>
    </div>`;
}

function renderCerrada() {
    return `<div class="flex-1 flex flex-col items-center justify-center text-center p-8 gap-5">
        <h1 class="text-2xl font-black">La sala se ha cerrado</h1>
        <p class="text-white/60 max-w-xs">El anfitrión ha terminado la sesión de ${salaCodigo}. Para seguir jugando, únete a una sala nueva.</p>
        <a href="/" class="mt-4 rounded-2xl px-8 py-3.5 font-bold text-white" style="background:linear-gradient(135deg,#8b5cf6,#ec4899 55%,#22d3ee)">Volver al inicio</a>
    </div>`;
}

function renderFin() {
    const g = estado.ganador;
    const ganadorHtml = g ? `<div class="flex items-center gap-3 rounded-2xl px-5 py-3" style="background:#13141b;border:1px solid rgba(255,255,255,0.06)">
        ${avatar(g.apodo, 44)}<div class="text-left"><p class="font-bold">${esc(g.apodo)}</p><p class="text-sm" style="color:#ffce4d">BINGO</p></div></div>` : '';
    return `<div class="flex-1 flex flex-col items-center justify-center text-center p-8 gap-5">
        <div class="text-5xl">🏆</div>
        <h1 class="text-2xl font-black">Partida finalizada</h1>
        ${ganadorHtml}
        <a href="/" class="mt-4 rounded-2xl px-8 py-3.5 font-bold text-white" style="background:linear-gradient(135deg,#8b5cf6,#ec4899 55%,#22d3ee)">Volver al inicio</a>
    </div>`;
}

let lastHtml = null;
function render() {
    const app = document.getElementById('app');
    let html;
    switch (view) {
        case 'cerrada': html = renderCerrada(); break;
        case 'jugando': html = renderJugando(); break;
        case 'comprobando': html = renderComprobando(); break;
        case 'aviso': html = renderAviso(); break;
        case 'ganaste': html = renderGanaste(); break;
        case 'fin': html = renderFin(); break;
        default: html = renderEspera();
    }
    // Sin cambios no se toca el DOM: conserva el scroll, el foco y lo que lee el lector de pantalla.
    if (html !== lastHtml) {
        lastHtml = html;
        app.innerHTML = html;
    }
    updateActions();
}

// ---------- confeti ----------
let confettiDone = false;
function launchConfetti() {
    if (confettiDone) return;
    confettiDone = true;
    vibrate([0, 90, 50, 90, 50, 180]);
    const colors = ['#f25dad', '#2fd4e3', '#ffce4d', '#3ed993', '#8b5cf6'];
    for (let i = 0; i < 60; i++) {
        const p = document.createElement('div');
        p.className = 'f-confetti';
        p.style.left = Math.random() * 100 + 'vw';
        p.style.background = colors[i % colors.length];
        p.style.animationDuration = (1.6 + Math.random() * 1.8) + 's';
        p.style.animationDelay = (Math.random() * 0.5) + 's';
        document.body.appendChild(p);
        setTimeout(() => p.remove(), 3600);
    }
}

// ---------- estado / vista ----------
function deriveView() {
    if (roomClosed) return 'cerrada';
    if (!estado) return 'espera';
    const g = estado.ganador;
    const rc = estado.reclamacionActiva;

    if (g && g.jugadorId === jugadorId) return 'ganaste';
    if (estado.estadoPartida === 'FINALIZADA') return 'fin';
    if (rc && rc.jugadorId === jugadorId) {
        // El servidor ya tiene el canto: a partir de aquí manda su estado, y al
        // rechazarlo o aprobarlo la vista vuelve a la partida.
        pendingClaim = null;
        return 'comprobando';
    }
    // Optimista mientras el canto no aparece en el servidor; si el anfitrión lo resolvió
    // antes de que lo viéramos, a los 10 s se vuelve a la partida.
    if (pendingClaim && !rc && Date.now() - pendingClaimAt < 10000) return 'comprobando';
    if (rc) return 'aviso';
    if (estado.estadoPartida === 'EN_JUEGO') { pendingClaim = null; return 'jugando'; }
    return 'espera';
}

async function reclamar(tipo) {
    if (!partidaId || cards.length === 0 || pendingClaim) return;
    const card = pickClaimCard(tipo);
    pendingClaim = tipo;
    pendingClaimAt = Date.now();
    vibrate(40);
    view = 'comprobando';
    render();
    let error = null;
    try {
        const res = await fetch('/api/reclamaciones', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ partidaId, jugadorId, cartonId: card.cartonId, tipo }),
            signal: timeoutSignal(FETCH_TIMEOUT)
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.exito) {
            error = data.error || 'No se ha podido cantar. Inténtalo otra vez.';
        }
    } catch (e) {
        error = 'Sin conexión: tu canto no ha llegado. Inténtalo otra vez.';
    }
    if (error) {
        pendingClaim = null;
        view = deriveView();
        render();
        showToast(error);
    }
}

function timeoutSignal(ms) {
    if (AbortSignal.timeout) return AbortSignal.timeout(ms);
    const controller = new AbortController();
    setTimeout(() => controller.abort(), ms);
    return controller.signal;
}

async function loadCards() {
    if (!partidaId) return;
    try {
        const res = await fetch(`/api/jugadores/${jugadorId}/cartones?partidaId=${partidaId}`, { signal: timeoutSignal(FETCH_TIMEOUT) });
        if (!res.ok) return;
        const data = await res.json();
        if (data.exito && data.cartones) {
            cards = data.cartones;
            ownNumbers = new Set(cards.flatMap(c => (c.cuadricula || []).flat().filter(n => n)));
        }
    } catch (e) { /* reintenta en el próximo ciclo */ }
}

async function refreshState() {
    try {
        const lobbyHeaders = lobbyEtag ? { 'If-None-Match': lobbyEtag } : {};
        const lobbyRes = await fetch(`/api/salas/${salaCodigo}/lobby`, { headers: lobbyHeaders, signal: timeoutSignal(FETCH_TIMEOUT) });

        if (lobbyRes.status === 429) { pollInterval = Math.min(pollInterval * 2, 10000); return; }
        if (lobbyRes.status === 404) {
            roomClosed = true;
        } else if (lobbyRes.status !== 304) {
            if (!lobbyRes.ok) throw new Error(`lobby ${lobbyRes.status}`);
            lobbyEtag = lobbyRes.headers.get('ETag');
            const lobbyData = await lobbyRes.json();
            if (lobbyData.exito) {
                players = (lobbyData.jugadores || []).map(j => j.apodo);
                partidaId = lobbyData.partidaActiva ? lobbyData.partidaActiva.id : null;
            }
        }

        if (roomClosed) {
            estado = null;
        } else if (partidaId) {
            if (cards.length === 0) await loadCards();
            const estadoHeaders = estadoEtag ? { 'If-None-Match': estadoEtag } : {};
            const partidaRes = await fetch(`/api/partidas/${partidaId}/estado`, { headers: estadoHeaders, signal: timeoutSignal(FETCH_TIMEOUT) });
            if (partidaRes.status === 429) { pollInterval = Math.min(pollInterval * 2, 10000); return; }
            if (partidaRes.status !== 304) {
                if (!partidaRes.ok) throw new Error(`estado ${partidaRes.status}`);
                estadoEtag = partidaRes.headers.get('ETag');
                const data = await partidaRes.json();
                if (data.exito) {
                    estado = data;
                    drawnBalls = data.bolasSacadas || [];
                    history = data.historial || [];
                    currentBall = data.bolaActual || null;
                    // Vibra si la bola recién cantada está en alguno de mis cartones.
                    if (currentBall && currentBall !== prevBallSeen) {
                        prevBallSeen = currentBall;
                        if (ownNumbers.has(currentBall)) vibrate(80);
                    }
                }
            }
        } else {
            estado = null;
        }

        view = deriveView();
        if (view === 'jugando') requestWake(); else releaseWake();
        // La partida o la sala ya terminaron: no hay nada más que sondear.
        if (['ganaste', 'fin', 'cerrada'].includes(view)) stopped = true;
        render();

        errorCount = 0;
        pollInterval = POLL_BASE;
    } catch (e) {
        errorCount++;
        pollInterval = Math.min(POLL_BASE * Math.pow(1.5, errorCount), 10000);
    }
    updateConnection();
}

// Un solo ciclo de sondeo a la vez; en pausa con la pestaña oculta.
async function poll() {
    clearTimeout(pollTimer);
    if (polling || stopped) return;
    polling = true;
    await refreshState();
    polling = false;
    if (!stopped && !document.hidden) pollTimer = setTimeout(poll, pollInterval);
}

document.addEventListener('visibilitychange', () => {
    if (document.hidden) {
        clearTimeout(pollTimer);
        return;
    }
    poll();
    if (view === 'jugando') requestWake();
});
window.addEventListener('online', poll);
window.addEventListener('offline', updateConnection);

render();
poll();
</script>
{% endblock %}
