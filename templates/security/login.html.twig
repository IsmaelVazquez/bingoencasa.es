{% extends 'admin/base_admin.html.twig' %}

{% block title %}Iniciar sesión{% endblock %}

{% block body %}
    <section class="min-h-screen bg-slate-50 text-slate-900 flex items-center justify-center px-4">
        <div class="w-full max-w-md">
            <div class="mb-8 text-center space-y-2">
                <p class="text-sm font-semibold uppercase tracking-widest text-indigo-600">Panel</p>
                <h1 class="text-3xl font-bold">Accede al panel</h1>
                <p class="text-slate-600">Introduce tus credenciales de administrador para continuar.</p>
            </div>
            {% if error %}
                <div class="mb-4 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-red-800">
                    {{ error.messageKey|trans(error.messageData, 'security') }}
                </div>
            {% endif %}
            <div class="rounded-xl border border-slate-200 bg-white/80 p-6 shadow-sm backdrop-blur">
                <form method="post" class="space-y-4">
                    <div>
                        <label class="block text-sm font-semibold text-slate-700" for="inputEmail">Email</label>
                        <input id="inputEmail" name="email" type="email" autocomplete="email" required value="{{ last_username }}" class="mt-1 w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-slate-900 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200" />
                    </div>
                    <div>
                        <div class="flex items-center justify-between">
                            <label class="block text-sm font-semibold text-slate-700" for="inputPassword">Contraseña</label>
                            <a href="/" class="text-xs font-semibold text-indigo-600 hover:text-indigo-500">Volver</a>
                        </div>
                        <input id="inputPassword" name="password" type="password" autocomplete="current-password" required class="mt-1 w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-slate-900 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200" />
                    </div>
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}" />
                    <button class="w-full rounded-lg bg-indigo-600 px-3 py-2 text-white font-semibold shadow hover:bg-indigo-500 transition" type="submit">Entrar</button>
                </form>
            </div>
        </div>
    </section>
{% endblock %}
